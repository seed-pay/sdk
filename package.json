{
  "name": "@seedpay/sdk",
  "version": "0.0.9",
  "homepage": "https://seedpay.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seed-pay/seedpay-sdk.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "test": "bun test --coverage",
    "patch": "bun pm version patch && git push --follow-tags"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "blockchain-wallet-validator": "1.2.1",
    "micro-eth-signer": "0.20.1",
    "ofetch": "1.5.1",
    "uuid": "14.0.3",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "fetch-mock": "12.6.0",
    "tsup": "9.0.0",
    "typescript": "5.9.3"
  }
}
